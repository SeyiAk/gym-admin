# Copy to .env.development / .env.production. Real .env files are gitignored.

# Dev: requests go to /api and Vite proxies them to API_BASE_URL_DEV (no CORS).
VITE_APP_BASE_URL=/api
API_BASE_URL_DEV=https://hgfitaccess-api.onrender.com

# Prod: the full API root including /api, e.g. https://api.hgfitaccess.com/api
# VITE_APP_BASE_URL=https://hgfitaccess-api.onrender.com/api

# "true" enables the 5-minute idle logout.
VITE_APP_FEATURE_ENABLED=false

# "true" serves API responses from src/mocks (MSW) instead of the backend. `yarn dev:mock` sets it.
VITE_APP_MOCK=false
